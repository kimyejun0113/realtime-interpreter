# https://console.groq.com/keys 에서 무료로 발급
GROQ_API_KEY=

# 음성인식 모델 (Groq)
STT_MODEL=whisper-large-v3-turbo

# 번역 엔진: groq 또는 gemini
TRANSLATE_PROVIDER=groq
TRANSLATE_MODEL=openai/gpt-oss-120b
# gemini 사용 시 (https://aistudio.google.com/apikey 무료 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 한국어가 아닌 말 -> 이 언어로, 한국어 -> OTHER_LANG 으로
MAIN_TARGET_LANG=ko
OTHER_LANG=en

# 발화 분할: 이 시간(ms)만큼 조용하면 끊어서 바로 통역
VAD_SILENCE_MS=400
# 계속 말해도 이 길이(초)가 되면 강제로 끊음
MAX_SEGMENT_SEC=5
# 0~3, 높을수록 잡음에 덜 민감
VAD_AGGRESSIVENESS=2

# 1이면 Groq 한도 초과 시 로컬 faster-whisper 로 전환 (pip install faster-whisper 필요)
LOCAL_STT_FALLBACK=0
LOCAL_STT_MODEL=small

# 통역 기록은 항상 logs/날짜.jsonl 에 저장됨. 1이면 음성(wav)도 같이 저장 (나중에 학습 데이터용)
SAVE_AUDIO=0

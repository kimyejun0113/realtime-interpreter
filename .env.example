# https://console.groq.com/keys 에서 무료로 발급
GROQ_API_KEY=

# 말하는 언어: en(영어 -> 한국어) 또는 ko(한국어 -> 영어). 앱 메뉴에서도 바꿀 수 있음
INPUT_LANG=en

# 음성인식은 로컬(무료, 단어 단위 실시간)로 함.
# groq: 문장이 끝나면 Whisper로 한 번 더 다듬음(문장부호/정확도). 한도가 부족하면 자동으로 건너뜀
# local: 음성인식 API를 전혀 쓰지 않음
FINAL_STT=groq
STT_MODEL=whisper-large-v3-turbo

# 문장이 끝났을 때 최종 번역 모델 (Groq). 한도가 차면 FALLBACK_MODELS -> Gemini -> 로컬 번역 순으로 대신함
TRANSLATE_MODEL=qwen/qwen3.8-27b
FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# PARTIAL_ENGINE=groq 일 때 실시간 임시 번역에 쓰는 모델
PARTIAL_MODEL=openai/gpt-oss-20b

# 말하는 도중 실시간 임시 번역
LIVE_TRANSLATION=1
# local: 이 PC에서 번역 (무료, 한도 없음) / groq: PARTIAL_MODEL 사용 (한도 소모)
PARTIAL_ENGINE=local
# 실시간 번역 갱신 최소 간격(초)과 최소 새 단어 수. 비워두면 local 0.6초/1단어, groq 2초/4단어
PARTIAL_INTERVAL_SEC=
PARTIAL_MIN_NEW_WORDS=

# 선택(유료): OpenAI 키를 넣으면 문장 최종 번역을 OpenAI가 먼저 맡고 Groq는 예비가 됨
# https://platform.openai.com/api-keys 에서 발급, 사용한 만큼 과금 (gpt-4o-mini 기준 1시간 통역에 대략 100원 안팎, 가격은 OpenAI 요금표 확인)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 선택: Groq 한도가 다 찼을 때 쓸 예비 번역 엔진 (https://aistudio.google.com/apikey 무료 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 한국어가 아닌 말 -> MAIN_TARGET_LANG, 한국어 -> OTHER_LANG
MAIN_TARGET_LANG=ko
OTHER_LANG=en

# 이만큼(초) 말이 끊기면 문장이 끝난 것으로 보고 최종 번역
ENDPOINT_SILENCE_SEC=0.6
# 마침표 없이 계속 말해도 이 길이(초)가 되면 문장을 끊음
MAX_UTTERANCE_SEC=30

# 통역 기록은 항상 logs/날짜.jsonl 에 저장됨. 1이면 음성(wav)도 같이 저장 (나중에 학습 데이터용)
SAVE_AUDIO=0

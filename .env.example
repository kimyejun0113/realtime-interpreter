# https://console.groq.com/keys 에서 무료로 발급
GROQ_API_KEY=

# 말하는 언어: auto(영어/한국어 자동 감지), en(영어 -> 한국어), ko(한국어 -> 영어). 앱 메뉴에서도 바꿀 수 있음
INPUT_LANG=auto

# 음성인식은 로컬(무료, 단어 단위 실시간)로 함.
# groq: 문장이 끝나면 Whisper로 한 번 더 다듬음(문장부호/정확도). 한도가 부족하면 자동으로 건너뜀
# local: 음성인식 API를 전혀 쓰지 않음
FINAL_STT=groq
STT_MODEL=whisper-large-v3-turbo

# 문장이 끝났을 때 최종 번역 엔진. 앞에서부터 쓰고, 한도가 차면 다음 엔진으로 넘어감.
# 키가 없는 엔진은 자동으로 건너뜀. 모두 막히면 이 PC의 로컬 번역(NLLB)이 대신함.
#   LLM:  provider:model  (groq, gemini, openai, github, cerebras, mistral, openrouter, deepseek)
#   번역 전용 서비스: deepl, azure
# 예) 무료 위주:  groq:qwen/qwen3.8-27b, gemini:gemini-2.5-flash-lite, deepl, groq:openai/gpt-oss-120b
# 예) 유료 1순위: openai:gpt-4o-mini, groq:qwen/qwen3.8-27b
TRANSLATE_ENGINES=groq:openai/gpt-oss-120b, groq:qwen/qwen3.8-27b, groq:openai/gpt-oss-20b

# ---- 엔진별 API 키 (쓰고 싶은 것만 채우면 됨) ----
# Gemini (무료 티어): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GitHub Models (GitHub 계정으로 무료, 하루 요청 수 적음): GitHub > Settings > Developer settings > Personal access tokens (models:read)
GITHUB_MODELS_TOKEN=
# Mistral (무료 Experiment 플랜, 전화번호 인증): https://console.mistral.ai
MISTRAL_API_KEY=
# OpenRouter (모델명 끝이 :free 인 모델은 무료, 하루 50회): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras (매우 빠름, 체험 크레딧): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# 유료(아주 저렴): OpenAI https://platform.openai.com/api-keys , DeepSeek https://platform.deepseek.com
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# 번역 전용 — DeepL API Free (월 50만 자 무료, 1시간 통역 ≈ 5만 자): https://www.deepl.com/pro-api
DEEPL_API_KEY=
# 번역 전용 — Azure Translator F0 (월 200만 자 무료): Azure Portal > Translator 리소스
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# 대화 기억: 최근 CONTEXT_RECENT 문장은 원문+번역, 그 앞 CONTEXT_OLDER 문장은 원문만 번역에 같이 보냄
# CONVERSATION_MEMO=1 이면 8문장마다 주제·인물·용어집 메모를 MEMO_ENGINES로 짧게 정리해 함께 보냄 (토큰 절약형)
CONTEXT_RECENT=2
CONTEXT_OLDER=6
CONVERSATION_MEMO=1
MEMO_ENGINES=groq:qwen/qwen3.8-27b, groq:openai/gpt-oss-20b

# PARTIAL_ENGINE=groq 일 때 실시간 임시 번역에 쓰는 Groq 모델
PARTIAL_MODEL=openai/gpt-oss-20b

# 말하는 도중 실시간 임시 번역
LIVE_TRANSLATION=1
# local: 이 PC에서 번역 (무료, 한도 없음) / groq: PARTIAL_MODEL 사용 (한도 소모)
PARTIAL_ENGINE=local
# 실시간 번역 갱신 최소 간격(초)과 최소 새 단어 수. 비워두면 local 0.6초/1단어, groq 2초/4단어
PARTIAL_INTERVAL_SEC=
PARTIAL_MIN_NEW_WORDS=

# 한국어 번역 말투: 합니다(~습니다) / 해요(~해요) / 한다(~한다)
KO_STYLE=합니다

# 한국어가 아닌 말 -> MAIN_TARGET_LANG, 한국어 -> OTHER_LANG
MAIN_TARGET_LANG=ko
OTHER_LANG=en

# 이만큼(초) 말이 끊기면 문장이 끝난 것으로 보고 최종 번역
ENDPOINT_SILENCE_SEC=0.6
# 마침표 없이 계속 말해도 이 길이(초)가 되면 문장을 끊음
MAX_UTTERANCE_SEC=30

# 통역 기록은 항상 logs/날짜.jsonl 에 저장됨. 1이면 음성(wav)도 같이 저장 (나중에 학습 데이터용)
SAVE_AUDIO=0
